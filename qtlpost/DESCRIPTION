Encoding: UTF-8
Depends: R (>= 4.1)
Imports:
    data.table,
    ggplot2,
    qvalue,
    limma,
    coloc,
    patchwork,
    mediation,
    UpSetR,
    circlize
Suggests:
    testthat (>= 3.0.0),
    knitr,
    rmarkdown,
