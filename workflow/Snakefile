# QTL pipeline: raw inputs -> standard QTL outputs -> downstream analyses
#
#   01 genotypes -> 02 phenotypes (adapters: bed | matrix | cci) -> 03 covariates
#   -> 04 QTLtools cis (permutation + nominal) -> 05 QC + standard outputs
#   -> 06 downstream (coloc, MAGMA, pi1, mediation, expression correlation, figures)
#
# Run from the repository root, e.g.
#   snakemake --profile profiles/local --configfile config/examples/cage.yaml
#   snakemake --profile profiles/local --configfile tests/configs/cci.yaml

from snakemake.utils import min_version, validate

min_version("8.0")


configfile: "config/config.yaml"


validate(config, "../config/schema/config.schema.yaml")


include: "rules/common.smk"
include: "rules/01_genotypes.smk"
include: "rules/02_phenotypes.smk"
include: "rules/03_covariates.smk"
include: "rules/04_qtl_mapping.smk"
include: "rules/05_qtl_qc.smk"
include: "rules/06_downstream.smk"


rule all:
    input:
        all_targets(),
