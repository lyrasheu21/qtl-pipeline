#!/usr/bin/env Rscript
# Minimal stand-in for `QTLtools cis`, for testing the pipeline on machines
# where QTLtools is unavailable (it only ships Linux binaries). NOT for real
# analyses. Selected with:  --configfile tests/configs/<test>.yaml tests/configs/mock.yaml
#
# Supports the options the pipeline uses: --vcf --bed --cov --out --permute N
# --nominal T --window --seed --normal --std-err --chunk k n --exclude-samples
# --grp-best (groups = BED gid column; output layout as QTLtools v1.3.1).
# Association = linear regression of the (rank-normalised) phenotype on
# genotype dosage after regressing out covariates. Permutation p-values use the
# same beta approximation idea as QTLtools. Output columns match QTLtools v1.3
# with --std-err.

suppressPackageStartupMessages(library(data.table))

args <- commandArgs(trailingOnly = TRUE)
if (length(args) == 0 || args[1] != "cis") stop("mock QTLtools only implements 'cis'")
args <- args[-1]
opt <- list(window = 1e6, seed = 1, normal = FALSE, chunk = c(1, 1), exclude = NULL, grp = FALSE)
i <- 1
while (i <= length(args)) {
  a <- args[i]
  switch(a,
    "--vcf" = { opt$vcf <- args[i + 1]; i <- i + 1 },
    "--bed" = { opt$bed <- args[i + 1]; i <- i + 1 },
    "--cov" = { opt$cov <- args[i + 1]; i <- i + 1 },
    "--out" = { opt$out <- args[i + 1]; i <- i + 1 },
    "--permute" = { opt$permute <- as.integer(args[i + 1]); i <- i + 1 },
    "--nominal" = { opt$nominal <- as.numeric(args[i + 1]); i <- i + 1 },
    "--window" = { opt$window <- as.numeric(args[i + 1]); i <- i + 1 },
    "--seed" = { opt$seed <- as.integer(args[i + 1]); i <- i + 1 },
    "--exclude-samples" = { opt$exclude <- readLines(args[i + 1]); i <- i + 1 },
    "--chunk" = { opt$chunk <- as.integer(args[(i + 1):(i + 2)]); i <- i + 2 },
    "--normal" = { opt$normal <- TRUE },
    "--std-err" = {},
    "--grp-best" = { opt$grp <- TRUE },
    stop("mock QTLtools: unsupported option ", a)
  )
  i <- i + 1
}
set.seed(opt$seed)

bed <- fread(cmd = paste("gzip -dc", shQuote(opt$bed)))
setnames(bed, 1:6, c("chr", "start", "end", "pid", "gid", "strand"))
vcf <- fread(cmd = paste("gzip -dc", shQuote(opt$vcf), "| grep -v '^##'"))
setnames(vcf, 1:3, c("CHROM", "POS", "ID"))
cov <- fread(opt$cov)

samples <- Reduce(intersect, list(names(bed)[-(1:6)], names(vcf)[-(1:9)], names(cov)[-1]))
samples <- setdiff(samples, opt$exclude)

# chunk k of n (by phenotype order)
chunk_of <- if (nrow(bed)) ceiling(seq_len(nrow(bed)) * opt$chunk[2] / nrow(bed)) else integer(0)
bed <- bed[chunk_of == opt$chunk[1]]
cat(sprintf("mock QTLtools: %d phenotypes in chunk %d/%d, %d samples\n", nrow(bed), opt$chunk[1], opt$chunk[2], length(samples)))
if (nrow(bed) == 0) { file.create(opt$out); quit(save = "no") }

dosage <- function(gt) {
  gt <- sub(":.*$", "", gsub("|", "/", gt, fixed = TRUE))
  out <- rep(NA_real_, length(gt))
  out[gt == "0/0"] <- 0; out[gt %in% c("0/1", "1/0")] <- 1; out[gt == "1/1"] <- 2
  out
}
G <- t(apply(as.matrix(vcf[, ..samples]), 1, dosage))
dimnames(G) <- list(vcf$ID, samples)
G[is.na(G)] <- rowMeans(G, na.rm = TRUE)[row(G)][is.na(G)]

cv <- as.data.frame(t(as.matrix(cov[, ..samples])), stringsAsFactors = FALSE)
names(cv) <- make.names(cov[[1]])
for (n in names(cv)) {
  num <- suppressWarnings(as.numeric(cv[[n]]))
  cv[[n]] <- if (all(!is.na(num))) num else factor(cv[[n]])
}

# phenotype -> group (each phenotype is its own group unless --grp-best)
bed[, grp := if (opt$grp) gid else pid]
lines <- character()
for (gname in unique(bed$grp)) {
  members <- bed[grp == gname]
  ph <- members[1]
  cis <- which(as.character(vcf$CHROM) == sub("^chr", "", ph$chr) &
               vcf$POS >= min(members$start) - opt$window & vcf$POS <= max(members$end) + opt$window)
  head_of <- function(m, best_pid) {
    id <- if (opt$grp) gname else m$pid
    extra <- if (opt$grp) sprintf(" %s %d", best_pid, nrow(members)) else ""
    sprintf("%s %s %d %d %s%s %d", id, sub("^chr", "", m$chr), m$start, m$end, m$strand, extra, length(cis))
  }
  # per phenotype: residualised y and genotypes
  fits <- lapply(seq_len(nrow(members)), function(k) {
    m <- members[k]
    y <- as.numeric(unlist(m[, ..samples]))
    keep <- !is.na(y)
    if (opt$normal) y[keep] <- qnorm((rank(y[keep]) - 0.5) / sum(keep))
    X <- model.matrix(~ ., data = cv[keep, , drop = FALSE])
    resid <- function(v) as.numeric(v - X %*% qr.solve(X, v))
    ry <- resid(y[keep])
    rg <- if (length(cis)) t(apply(G[cis, keep, drop = FALSE], 1, resid)) else matrix(nrow = 0, ncol = sum(keep))
    if (length(cis) == 1) rg <- matrix(rg, nrow = 1)
    list(ry = ry, rg = rg, dof = sum(keep) - ncol(X) - 1)
  })
  ok <- if (length(cis)) Reduce(`&`, lapply(fits, function(f) apply(f$rg, 1, function(v) sd(v) > 1e-8))) else logical(0)
  cis_ok <- cis[ok]
  assoc <- function(f, yv) {
    rg <- f$rg[ok, , drop = FALSE]
    r <- as.numeric(cor(t(rg), yv))
    t_stat <- r * sqrt(f$dof / pmax(1 - r^2, 1e-12))
    slope <- as.numeric(rg %*% yv) / rowSums(rg^2)
    list(r = r, t = t_stat, p = 2 * pt(-abs(t_stat), f$dof), slope = slope, se = abs(slope / t_stat))
  }
  if (!length(cis_ok)) {
    if (!is.null(opt$permute)) lines <- c(lines, paste(head_of(ph, "NA"), paste(rep("NA", 15), collapse = " ")))
    next
  }
  res <- lapply(fits, function(f) assoc(f, f$ry))
  best_p <- vapply(res, function(a) min(a$p), 0)
  kb <- which.min(best_p)
  snp_cols <- sprintf("%d %s %s %d %d", vcf$POS[cis_ok] - members$start[kb], vcf$ID[cis_ok], vcf$CHROM[cis_ok],
                      vcf$POS[cis_ok], vcf$POS[cis_ok])
  if (!is.null(opt$nominal)) {
    for (k in seq_along(fits)) {
      a <- res[[k]]
      sel <- which(a$p <= opt$nominal)
      best_snp <- which.min(res[[kb]]$p)
      snp_k <- sprintf("%d %s %s %d %d", vcf$POS[cis_ok] - members$start[k], vcf$ID[cis_ok], vcf$CHROM[cis_ok],
                       vcf$POS[cis_ok], vcf$POS[cis_ok])
      hd <- head_of(members[k], members$pid[k])
      lines <- c(lines, sprintf("%s %s %g %g %g %g %d", hd, snp_k[sel], a$p[sel], a$r[sel]^2, a$slope[sel],
                                a$se[sel], as.integer(k == kb & sel == best_snp)))
    }
  } else {
    a <- res[[kb]]
    bs <- which.min(a$p)
    perm_min <- replicate(opt$permute, {
      idx <- sample(length(fits[[1]]$ry))
      min(vapply(fits, function(f) min(assoc(f, f$ry[idx])$p), 0))
    })
    m <- mean(perm_min); v <- var(perm_min)
    common <- m * (1 - m) / v - 1
    shape1 <- m * common; shape2 <- (1 - m) * common
    adj_emp <- (sum(perm_min <= a$p[bs]) + 1) / (opt$permute + 1)
    adj_beta <- pbeta(a$p[bs], shape1, shape2)
    lines <- c(lines, sprintf("%s %s %d %g %g %g %g %g %g %g %g %g", head_of(members[kb], members$pid[kb]),
                              snp_cols[bs], fits[[kb]]$dof, fits[[kb]]$dof, shape1, shape2, a$p[bs],
                              a$r[bs]^2, a$slope[bs], a$se[bs], adj_emp, adj_beta))
  }
}
writeLines(lines, opt$out)
